{
  "name": "tafeito",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply tafeito-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply tafeito-db --remote",
    "db:seed:local": "node --env-file-if-exists=.env.seed scripts/seed.ts",
    "db:setup": "npm run db:migrate:local && npm run db:seed:local",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:seed:remote": "node --env-file-if-exists=.env.seed scripts/seed.ts --remote --sem-demo"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "drizzle-orm": "^0.45.4",
    "next": "16.3.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  }
}