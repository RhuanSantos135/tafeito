{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tafeito",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tafeito-db",
      // Troque pelo id gerado em `wrangler d1 create tafeito-db` antes do deploy
      "database_id": "d7edf04c-fcd4-4ce1-befb-b0a2b653ded2",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}